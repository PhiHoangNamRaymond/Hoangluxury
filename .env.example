# Google Drive catalog or pricing sheet shared link
VITE_CATALOG_URL=

# Deployed Google Apps Script Web App URL ending in /exec.
# Dùng chung cho cả form đặt xe (/booking/) và form phản hồi (/feedback/);
# script phân biệt bằng tham số form=feedback.
# Never place the private Google Sheet URL or spreadsheet ID in this file.
VITE_BOOKING_SHEET_ENDPOINT=

# Supabase frontend configuration. Public keys are visible in the browser;
# security depends on grants/RLS applied separately on the database.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Hostinger: set these ONLY in Supabase Edge Functions > Secrets.
BLOG_SERVER_KEY=
BLOG_ALLOWED_ORIGINS=https://hoangluxury.travel,http://localhost:5173
# Legacy server-key fallback. NEVER use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
