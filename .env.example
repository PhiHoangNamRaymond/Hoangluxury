# Google Drive catalog or pricing sheet shared link
VITE_CATALOG_URL=

# Legacy public configuration; kept for upgrade validation only, not used by UI.
# Configure GOOGLE_FORMS_ENDPOINT in Edge Function Secrets instead.
VITE_BOOKING_SHEET_ENDPOINT=

# New verified transport; the legacy direct GAS endpoint is no longer used by UI.
VITE_FORMS_PROXY_URL=
VITE_TURNSTILE_SITE_KEY=
# Store ONLY in Edge Function Secrets / Apps Script properties, never VITE_.
GOOGLE_FORMS_ENDPOINT=
FORMS_PROXY_SECRET=
TURNSTILE_SECRET_KEY=
FORMS_ALLOWED_ORIGINS=https://hoangluxury.travel,https://www.hoangluxury.travel

# Supabase frontend configuration. Public keys are visible in the browser;
# security depends on grants/RLS applied separately on the database.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Hostinger: set these ONLY in Supabase Edge Functions > Secrets.
BLOG_SERVER_KEY=
# Development origins belong in a separate staging function configuration only.
BLOG_ALLOWED_ORIGINS=https://hoangluxury.travel,https://www.hoangluxury.travel
# Legacy server-key fallback. NEVER use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
