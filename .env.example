# Google Drive catalog or pricing sheet shared link
VITE_CATALOG_URL=

# Deployed Google Apps Script Web App URL ending in /exec.
# Dùng chung cho cả form đặt xe (/booking/) và form phản hồi (/feedback/);
# script phân biệt bằng tham số form=feedback.
# Never place the private Google Sheet URL or spreadsheet ID in this file.
VITE_BOOKING_SHEET_ENDPOINT=
