RewriteRule ^photo/albums/sunset-together/?$ /hoangphoto/couples-honeymoons/sunset-together/ [R=301,L]
RewriteRule ^photo/albums/melody-of-the-mountains/?$ /hoangphoto/couples-honeymoons/melody-of-the-mountains/ [R=301,L]
