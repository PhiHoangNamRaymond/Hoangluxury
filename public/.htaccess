DirectoryIndex index.html

# Static production hardening; keep existing privacy/redirect rules on hosting.
Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co https://challenges.cloudflare.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; frame-src https://challenges.cloudflare.com https://www.youtube-nocookie.com; upgrade-insecure-requests"
  Header always set Cache-Control "no-store" "expr=%{REQUEST_URI} =~ m#^/admin(?:/|$)#"
</IfModule>

# Never serve source, credentials or database exports even if mis-uploaded.
<FilesMatch "(?i)(^\.|\.(?:env|sql|gs|log|pem|key|p12|pfx|dump|backup|zip|map)$|^(?:package(?:-lock)?\.json|README\.md|SECURITY\.md)$)">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteBase /

RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^(?:src|api|supabase|google-apps-script|tests|scripts|node_modules|backups|credentials|secrets)(?:/|$) - [F,L,NC]

# Khách từ Việt Nam, Lào, Campuchia, Myanmar, Trung Quốc thấy trang thông báo
# (29/10/2026); trừ /admin (viết blog) và file phục vụ trang đó. Cần Cloudflare
# proxy (đám mây cam) để có header CF-IPCountry. Cùng quy tắc ở vercel.json.
RewriteCond %{HTTP:CF-IPCountry} ^(VN|LA|KH|MM|CN)$ [NC]
RewriteCond %{REQUEST_URI} !^/(?:admin|unavailable|assets/|favicon|icon-|apple-touch-icon|robots\.txt)
RewriteRule ^ /unavailable/ [R=302,L]

# Consolidate legacy aliases and old journey slugs on their canonical URLs.
RewriteRule ^journeys/?$ /routes/ [R=301,L]
# Tuyến và trang du thuyền đã chuyển sang /routes/ (28/10/2026).
RewriteRule ^journey/cao-bang/?$ /routes/hanoi-to-cao-bang-private-car/ [R=301,L]
RewriteRule ^journey/hanoi-to-cao-bang-private-transfer/?$ /routes/hanoi-to-cao-bang-private-car/ [R=301,L]
RewriteRule ^journey/mu-cang-chai/?$ /routes/hanoi-to-mu-cang-chai-private-car/ [R=301,L]
RewriteRule ^journey/hanoi-to-mu-cang-chai-private-transfer/?$ /routes/hanoi-to-mu-cang-chai-private-car/ [R=301,L]
RewriteRule ^journey/moc-chau/?$ /routes/hanoi-to-moc-chau-private-car/ [R=301,L]
RewriteRule ^journey/hanoi-to-moc-chau-private-transfer/?$ /routes/hanoi-to-moc-chau-private-car/ [R=301,L]
RewriteRule ^journey/ta-xua/?$ /routes/hanoi-to-ta-xua-private-car/ [R=301,L]
RewriteRule ^journey/hanoi-to-ta-xua-private-transfer/?$ /routes/hanoi-to-ta-xua-private-car/ [R=301,L]
RewriteRule ^journey/pu-luong/?$ /routes/hanoi-to-pu-luong-private-car/ [R=301,L]
RewriteRule ^journey/hanoi-to-pu-luong-private-transfer/?$ /routes/hanoi-to-pu-luong-private-car/ [R=301,L]
RewriteRule ^journey/sapa-to-ha-long/?$ /routes/sapa-to-halong-bay-private-car/ [R=301,L]
RewriteRule ^journey/sapa-to-ha-long-private-transfer/?$ /routes/sapa-to-halong-bay-private-car/ [R=301,L]
RewriteRule ^journey/sapa-to-ninh-binh/?$ /routes/sapa-to-ninh-binh-private-car/ [R=301,L]
RewriteRule ^journey/sapa-to-ninh-binh-private-transfer/?$ /routes/sapa-to-ninh-binh-private-car/ [R=301,L]
RewriteRule ^journey/sapa-to-ha-giang/?$ /routes/sapa-to-ha-giang-private-car/ [R=301,L]
RewriteRule ^journey/sapa-to-ha-giang-private-transfer/?$ /routes/sapa-to-ha-giang-private-car/ [R=301,L]
RewriteRule ^journey/sapa-to-mu-cang-chai/?$ /routes/sapa-to-mu-cang-chai-private-car/ [R=301,L]
RewriteRule ^journey/sapa-to-mu-cang-chai-private-transfer/?$ /routes/sapa-to-mu-cang-chai-private-car/ [R=301,L]
RewriteRule ^journey/ha-long-to-sapa/?$ /routes/halong-bay-to-sapa-private-car/ [R=301,L]
RewriteRule ^journey/ha-long-to-sapa-private-transfer/?$ /routes/halong-bay-to-sapa-private-car/ [R=301,L]
RewriteRule ^routes/halong-to-sapa-private-car/?$ /routes/halong-bay-to-sapa-private-car/ [R=301,L]
RewriteRule ^journey/ninh-binh-to-sapa/?$ /routes/ninh-binh-to-sapa-private-car/ [R=301,L]
RewriteRule ^journey/ninh-binh-to-sapa-private-transfer/?$ /routes/ninh-binh-to-sapa-private-car/ [R=301,L]
RewriteRule ^cruises/?$ /routes/halong-bay-cruises/ [R=301,L]
RewriteRule ^ha-long-cruises/?$ /routes/halong-bay-cruises/ [R=301,L]
RewriteRule ^journey/(?:sapa|hanoi-to-sapa-private-transfer)/?$ /routes/hanoi-to-sapa-private-transfer/ [R=301,L]
RewriteRule ^journey/(?:ha-long|hanoi-to-ha-long-private-transfer)/?$ /routes/hanoi-to-halong-bay-private-transfer/ [R=301,L]
RewriteRule ^journey/(?:ninh-binh|hanoi-to-ninh-binh-private-transfer)/?$ /routes/hanoi-to-ninh-binh-private-transfer/ [R=301,L]
RewriteRule ^journey/(?:ha-giang|hanoi-to-ha-giang-private-transfer)/?$ /routes/hanoi-to-ha-giang-private-transfer/ [R=301,L]
RewriteRule ^journey/(?:cat-ba|hanoi-to-cat-ba-private-transfer)/?$ /routes/hanoi-to-cat-ba-private-transfer/ [R=301,L]

# Khu ảnh chuyển từ /photo/ sang /hoangphoto/ (28/10/2026).
RewriteRule ^photo/?$ /hoangphoto/ [R=301,L]
RewriteRule ^photo/albums/?$ /hoangphoto/albums/ [R=301,L]
RewriteRule ^photo/albums/spring-blossom/?$ /hoangphoto/local-culture/spring-blossom/ [R=301,L]
