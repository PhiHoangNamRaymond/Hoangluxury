RewriteRule ^photo/albums/northern-vietnam-on-film/?$ /hoangphoto/cinematic-travel/northern-vietnam-on-film/ [R=301,L]

# Blog về /blog/, bài nằm dưới địa điểm: /blog/<địa điểm>/<bài>/ (29/10/2026).
# URL bài cũ khác có trang chuyển hướng tĩnh sinh lúc build. About sang /about-us/.
RewriteRule ^hoangphoto/blog/?$ /blog/ [R=301,L]
RewriteRule ^(hoangphoto/)?blog/sapa-travel-guide-everything-you-need-to-know/?$ /blog/sapa/sapa-travel-guide-everything-you-need-to-know/ [R=301,L]
RewriteRule ^about/?$ /about-us/ [R=301,L]

# React/Vite SPA fallback.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
